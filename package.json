{
  "name": "dsh-plugin-rea",
  "version": "2.0.13",
  "description": "One-plugin bundle: provisions Node/REA/JDK/Ghidra for you, then registers the upstream REA MCP server as mcp__rea__* tools. · 一体包：自动准备 Node/REA/JDK/Ghidra，并把上游 REA 的 MCP 服务接入 DeepSeek Harness。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "czcdr",
  "homepage": "https://github.com/czcdr/dsh-plugin-rea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czcdr/dsh-plugin-rea.git"
  },
  "bugs": {
    "url": "https://github.com/czcdr/dsh-plugin-rea/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "bundle",
    "mcp",
    "rea",
    "reverse-engineering",
    "ghidra",
    "binary-analysis"
  ],
  "bin": {
    "rea-bundle-setup": "./scripts/setup.mjs",
    "rea-bundle-status": "./bin/rea-shim.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "index.mjs",
    "client.js",
    "bin/",
    "scripts/",
    "manifest/",
    "docs/bundle-design.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "check-updates.ps1",
    "screenshots.json",
    "assets/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "check-updates": "node ./scripts/check-updates.mjs",
    "bundle:setup": "node ./scripts/setup.mjs",
    "bundle:status": "node ./bin/rea-shim.mjs --shim-status",
    "bundle:dry-run": "node ./scripts/setup.mjs --reuse --dry-run",
    "bundle:audit": "node ./scripts/audit-manifest.mjs",
    "bundle:test": "node --test ./scripts/setup.test.mjs",
    "bundle:host-compat": "node ./scripts/host-compat.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "dsh": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
